# Echo-Sight Voice RAG Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.

# Qdrant Vector Database Config
QDRANT_URL="https://your-qdrant-cluster-url.cloud.qdrant.io:6333"
QDRANT_API_KEY="your-qdrant-api-key-jwt"

# LLM Provider (Groq API)
GROQ_API_KEY="gsk_your_groq_api_key"

# Sarvam AI STT/Speech-to-Text API
SARVAM_API_KEY="sk_your_sarvam_api_key"
NEXT_PUBLIC_SARVAM_API_KEY="sk_your_sarvam_api_key"

# Deployed FastAPI backend (Railway) used by the Next.js UI
NEXT_PUBLIC_API_URL="https://voiceraghackerhouse-production.up.railway.app"
